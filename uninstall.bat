@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo ==========================================
echo  Удаление AI-ассистента
echo ==========================================
echo.
echo Всегда убирается:
echo   - автозагрузка с Windows (если была включена)
echo   - ярлыки на рабочем столе и в меню Пуск
echo   - ключи Gemini и токен Telegram из защищённого хранилища Windows
echo.
echo По вашему выбору удаляется ВСЁ остальное:
echo   настройки, история, расписание, макросы, логи и резервные копии (папка %%APPDATA%%\AI_Assistant)
echo.
echo Сама папка с программой и зависимости Python НЕ удаляются —
echo их можно стереть вручную после этого скрипта.
echo.
set /p CONFIRM="Продолжить? (y/n): "
if /i not "%CONFIRM%"=="y" goto :end
set WIPE=
set /p DATA="Удалить также настройки, историю и резервные копии БЕЗ возможности восстановления? (y/n): "
if /i "%DATA%"=="y" set WIPE=--wipe

python cleanup.py %WIPE%
if errorlevel 1 echo Не удалось запустить python cleanup.py — проверьте, что Python установлен.

echo Готово. Папку программы можешь удалить вручную.
:end
pause
